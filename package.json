{
  "name": "ffmpeg10mb",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx/esm --test tests/bitrate.test.ts tests/probe.test.ts tests/encode.test.ts tests/verify.test.ts",
    "cli": "node --import tsx/esm src/cli.ts",
    "gui": "npm run build && electron ./electron/main.mjs",
    "dev": "tsx src/index.ts",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "execa": "^9.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "description": "Comprime vídeos pra caber no limite do Discord",
  "author": "caiocost",
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.caiocost.felparizador",
    "productName": "Felparizador",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*.js",
      "package.json",
      "!node_modules/ffprobe-static/bin/{darwin,linux}/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Felparizador.exe"
    }
  }
}
